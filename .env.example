# apps/web (NEXT_PUBLIC_*, ビルド時埋め込み・秘匿不可)

# フロントエンドがAPIを呼び出す際のベースURL（ローカルではapps/apiの8787番ポートを指す）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api/v1
# CognitoユーザープールのID（フロントエンドの認証画面が参照する）
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# CognitoアプリクライアントのID（ユーザープール内でこのフロントエンドアプリを識別する）
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# CognitoホストUIのドメイン（OAuth/OIDCのリダイレクトフローで使用）
NEXT_PUBLIC_COGNITO_DOMAIN=

# apps/api

# PostgreSQLへの接続文字列（postgres://ユーザー名:パスワード@ホスト:ポート/DB名）。値はローカル開発用
DATABASE_URL=postgres://ideaboard:ideaboard_password@localhost:5432/ideaboard_DB
# AWS Secrets Managerに保存されたDB認証情報のARN（本番ではDATABASE_URLの代わりに使う想定）
DATABASE_SECRET_ARN=
# 画像などのアセットを保存するS3バケット名
ASSETS_BUCKET=
# エクスポートファイルを保存するS3バケット名
EXPORTS_BUCKET=
# バックエンドがJWT検証に使うCognitoユーザープールID（3行目はフロントエンド用）
COGNITO_USER_POOL_ID=
# CORSで許可するオリジン(ローカルのNext.js開発サーバー)
ALLOWED_ORIGIN=http://localhost:3000